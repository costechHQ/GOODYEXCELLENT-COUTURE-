ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://goody:goody@localhost:5432/goody
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600

# Enquiry notification email. Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
ENQUIRY_NOTIFY_TO=

# First Owner account. Set both, run `uv run python -m app.db.seed` once, then remove OWNER_PASSWORD.
# The password needs at least 12 characters.
OWNER_EMAIL=
OWNER_PASSWORD=

# Admin sign-in. JWT_SECRET must be at least 32 random characters; sign-in is off without it.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_MINUTES=30

# Image uploads. In production UPLOAD_DIR must be on persistent storage, and API_PUBLIC_URL must be
# the API's real public address (it is used to build image links).
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:8000
MAX_UPLOAD_BYTES=5242880
